{
	"name": "website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/photos/private-media-guard.mjs --source-only && node scripts/content/cli.ts check && vite build && node scripts/verify-build.mjs && node scripts/photos/private-media-guard.mjs --output build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"photos": "node scripts/photos/studio.mjs",
		"photos:upgrade": "node scripts/photos/upgrade.mjs",
		"photos:guard": "node scripts/photos/private-media-guard.mjs --output build",
		"test:photos": "node --test scripts/photos/*.test.mjs",
		"quality": "npm run content:check && npm run check && npm run lint && npm run test:photos && npm run test:content && npm run build",
		"deploy": "wrangler deploy",
		"content:check": "node scripts/content/cli.ts check",
		"content:new": "node scripts/content/cli.ts new",
		"content:revision": "node scripts/content/cli.ts revision",
		"test:content": "node --test scripts/content/*.test.ts scripts/photos/variants.test.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"heic-decode": "^2.1.0",
		"mdsvex": "^0.12.8",
		"parse5": "^8.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"wrangler": "^4.129.0",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	}
}
