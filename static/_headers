/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=()

# HTML uses Workers' default public, max-age=0, must-revalidate policy.
# Do not put Cache-Control under /*: overlapping rules concatenate values,
# which would give immutable assets conflicting max-age directives.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# This directory contains only generated, content-fingerprinted variants.
/images/photography/*
  Cache-Control: public, max-age=31536000, immutable
